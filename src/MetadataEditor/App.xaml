<Application x:Class="MetadataEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:views="clr-namespace:MetadataEditor.Views"
             xmlns:local="clr-namespace:MetadataEditor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <views:BoolToVisConverter x:Key="BoolToVis"/>
            <views:BoolToVisConverter x:Key="InverseBoolToVis" Invert="True"/>
            <views:InverseBoolConverter x:Key="InverseBool"/>
            <views:StringNullOrEmptyToVisConverter x:Key="StringNullOrEmptyToVis"/>
            <views:StringEqualsConverter x:Key="StringEqualsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

