<Window x:Class="MetadataEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="Settings &amp; Preferences"
        Height="540" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../Resources/app.ico"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Settings &amp; Preferences" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Customize application appearance, update checks, and defaults" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,16">
            <!-- THEME TAB -->
            <TabItem Header="🎨 Appearance &amp; Theme">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Color Theme" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Choose the appearance theme for Metadata Editor. Changes apply immediately." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <!-- Dark Theme Option -->
                                <RadioButton GroupName="ThemeGroup" Margin="0,0,0,12" Cursor="Hand"
                                             IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Dark'}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="🌙 Dark Slate (Default)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Modern dark palette with slate blue accents. Easy on the eyes for extended editing." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Midnight Option -->
                                <RadioButton GroupName="ThemeGroup" Margin="0,0,0,12" Cursor="Hand"
                                             IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Midnight'}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="🌌 Midnight Blue" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Deep dark contrast theme with rich midnight tones. Optimized for OLED screens." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Light Option -->
                                <RadioButton GroupName="ThemeGroup" Margin="0" Cursor="Hand"
                                             IsChecked="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Light'}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="☀️ Light Clean" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Clean white and light gray interface for brightly lit workspaces." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- UPDATES TAB -->
            <TabItem Header="🔄 Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Automatic Updates" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Configure how Metadata Editor checks for and installs new versions." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup}" Margin="0,0,0,14" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Check for updates automatically on startup" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Silently contacts GitHub Releases when the app launches and notifies you if a new version is published." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>

                                <Separator Margin="0,8,0,14"/>

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Installed Version:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AppVersionString, StringFormat='v{0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="Release Channel:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="GitHub Releases (KevinK56/MetadataEditor)" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Padding="14,6" IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄 " VerticalAlignment="Center"/>
                                            <TextBlock Text="Check for Updates Now" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- GENERAL TAB -->
            <TabItem Header="⚙️ General Defaults">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Editor Defaults" Style="{StaticResource SectionHeader}"/>

                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Default Format -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Format for New Files:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,14"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FileTypes}" SelectedItem="{Binding DefaultFileType}" Margin="0,0,0,14" Height="32"/>

                                <!-- Default Encoding -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Default Character Encoding:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,14"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Encodings}" SelectedItem="{Binding DefaultEncoding}" Margin="0,0,0,14" Height="32"/>

                                <!-- Backup Before Save -->
                                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" IsChecked="{Binding BackupBeforeSave}" Margin="0,6,0,14" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Create a .bak backup before overwriting existing files" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Safeguards your original metadata in case you need to revert changes." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Auto-detect Artwork -->
                                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding AutoDetectArtwork}" Margin="0,0,0,6" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Automatically scan for and display posters / cover artwork" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Detects poster.jpg, cover.jpg, and matching artwork files in the folder." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABOUT TAB -->
            <TabItem Header="ℹ️ About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- App Branding Card -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- App Icon -->
                                <Border Width="64" Height="64" CornerRadius="16" BorderBrush="#60A5FA" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0284C7" Offset="0.0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="NFO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Text="Edit" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" LineHeight="13" LineStackingStrategy="BlockLineHeight"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Metadata Editor" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Universal Movies, TV &amp; Music NFO Metadata Editor" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding AppVersionString, StringFormat='Version {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>

                                <TextBlock Text="A modern, high-performance desktop application for viewing, editing, and managing Kodi, Plex, Jellyfin, and Emby metadata files with full XML preservation and DOS ASCII support."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="480"/>

                                <Separator Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Publisher / Author:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="KevinK56" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="License:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT License (100% Free &amp; Open Source Software)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5"/>
                                </Grid>

                                <!-- Action Links -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/KevinK56/MetadataEditor" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐 " VerticalAlignment="Center"/>
                                            <TextBlock Text="GitHub Repository" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/KevinK56/MetadataEditor/releases" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦 " VerticalAlignment="Center"/>
                                            <TextBlock Text="Releases" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/KevinK56/MetadataEditor/issues">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🐛 " VerticalAlignment="Center"/>
                                            <TextBlock Text="Report an Issue" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="💾 Save Settings" Width="130" Margin="0,0,8,0" Click="SaveButton_Click"/>
                <Button Style="{StaticResource ModernButton}" Content="Close" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

